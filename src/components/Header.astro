---
const links = [['/','Главная'],['/about/','О нас'],['/services/','Услуги'],['/doula-training/','Обучение на доулу'],['/specialists/','Специалисты'],['/hospitals/','Роддома'],['/events/','Акушерство_посиделки'],['/cases/','Отзывы'],['/faq/','Вопросы'],['/blog/','Блог'],['/contacts/','Как добраться?']];
---
<header class="header"><div class="header-inner"><a class="brand" href="/" aria-label="Akusherstvo Club — главная"><img class="brand-logo" src="/images/logo.png" alt="Логотип Akusherstvo Club" width="200" height="164"/><span>Akusherstvo Club<span class="brand-sub">CLUB · БЕРЕЖНО К ВАМ</span></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Меню <span>☰</span></button><nav id="navigation" aria-label="Основная навигация">{links.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href || (href!=='/' && Astro.url.pathname.startsWith(href)) ? 'page':undefined}>{label}</a>)}</nav><a class="header-cta" href="#">Встретимся? <span>↗</span></a></div></header>
<script>const button=document.querySelector('.menu-toggle');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));document.querySelector('#navigation')?.classList.toggle('is-open',!open);});</script>




<style>
nav a{font-size:16px;line-height:1.5}
.menu-toggle{font-size:16px}
@media(min-width:901px){.header-inner{flex-wrap:wrap}.header-inner nav{order:3;width:100%;flex-wrap:wrap;gap:14px 24px;border-top:1px solid var(--line);padding-top:18px}}
@media(max-width:900px){
  .header-inner nav{flex-direction:column;flex-wrap:nowrap;align-items:stretch;gap:4px;width:100%}
  nav a{display:block;font-size:18px;line-height:1.5;padding:10px 16px;white-space:normal;overflow-wrap:anywhere}
}
</style>
