---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title="Блог о подготовке к родам" description="Блог Akusherstvo Club: как подготовить план родов, познакомиться с доулой и обсудить свои пожелания с командой. Статьи для будущих родителей."><PageIntro title="Знания, на которые можно опереться" eyebrow="БЛОГ КЛУБА" description="Небольшие статьи о подготовке, поддержке и внимании к себе."/><section class="container content-section"><div class="two-grid">{posts.map(post=><article class="article-card"><span class="eyebrow">{post.data.category}</span><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id}/`}>Читать статью ↗</a></article>)}</div></section><div class="container"><ContactForm/></div></Layout>
