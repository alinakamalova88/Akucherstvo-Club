---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactForm from '../components/ContactForm.astro';
const reviews=[
{name:'Владислава Карпенко',date:'26 сентября',tag:'Внимание к выбору · ЩПЦ',text:'Владислава рассказывает о родах с акушеркой Настей Кистер и врачом Анастасией Горбаневой. Для неё особенно важны были участие команды, возможность обсуждать варианты и постоянное наблюдение за состоянием мамы и ребёнка.'},
{name:'Екатерина',date:'25 сентября',tag:'Эмоциональная поддержка · забота в деталях',text:'В отзыве об Иване Луговском и акушерке Кристине Авгопуло Екатерина выделяет спокойное общение, поддержку уверенности в себе и внимание к бытовым мелочам после родов. Она описывает доверие к своей команде.'},
{name:'Кристина М.',date:'25 сентября',tag:'Работа команды · поддержка после родов',text:'Кристина благодарит акушерку Галину Хисамееву, доулу Марго Щурову и врача Инну Понамарёву. В её истории важны слаженность специалистов при изменении ситуации и готовность отвечать на вопросы до и после рождения ребёнка.'},
{name:'Алёна Сангаре',date:'23 сентября',tag:'Две истории родов · постоянство поддержки',text:'Алёна делится опытом двух родов с клубом. Она называет акушерок Юлию Григорову и Татьяну Лушникову, доулу Ольгу Новикову и подчёркивает человеческое отношение и поддержку не только во время родов, но и заранее.'}
];
---
<Layout title="Отзывы о клубе" description="Отзывы о сопровождении родов в Akusherstvo Club: краткие пересказы историй женщин о поддержке акушерок и доул со ссылками на оригиналы."><PageIntro title="Истории, в которых чувствуется забота" eyebrow="ОТЗЫВЫ О КЛУБЕ" description="Что женщины отмечают в работе акушерок и доул: отношение, общение с медицинской командой и поддержку в важные моменты."/><div class="container content-section"><div class="rating-banner"><strong>5,0 <span>★★★★★</span></strong><div>424 отзыва на странице клуба<p>По данным источника на 28 сентября 2026 года</p></div><a class="text-link" href="https://akusherstvo-club.clients.site/#rating" target="_blank" rel="noreferrer">Читать оригиналы ↗</a></div><p class="small">Ниже — краткие пересказы опубликованных отзывов, а не дословные цитаты. Личный опыт не гарантирует такой же сценарий родов.</p><div class="two-grid">{reviews.map(review=><article class="testimonial"><span class="eyebrow">{review.tag}</span><p>{review.text}</p><div><strong>{review.name}</strong><span>{review.date} · дата отображается в источнике без года</span></div><small>Краткий пересказ · <a class="underlined" href="https://akusherstvo-club.clients.site/#rating" target="_blank" rel="noreferrer">Оригинал на сайте клуба ↗</a></small></article>)}</div><a class="text-link" href="/specialists/" style="margin-top:30px">Познакомиться со специалистами →</a></div><div class="container"><ContactForm/></div></Layout>
